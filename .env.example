# From https://pan.baidu.com/union (百度网盘开放平台) -> 你的应用 -> 密钥
BAIDU_APP_KEY=
BAIDU_SECRET_KEY=

# Where the OAuth tokens (obtained by `npm run authorize`) get stored.
# Defaults to ~/.baidu-netdisk-mcp/tokens.json if unset.
BAIDU_TOKEN_STORE=

# --- Only needed for remote/cloud deployment (src/httpServer.js) ---
# Required: long random secret, e.g. `openssl rand -hex 32`. Callers must
# send it as `Authorization: Bearer <token>`. The server refuses to start
# without this set.
MCP_AUTH_TOKEN=
PORT=3000
HOST=0.0.0.0
